# Copiare come .env e modificare se serve. Tutte le variabili sono facoltative.

# Cartella radice: i file finiscono in <OUTPUT_DIR>/sitap/AAAA-MM-GG/
OUTPUT_DIR=.

# Layer da scaricare: pun (punti), lin (linee), pol (poligoni)
LAYERS=pun,lin,pol

# Record per pagina WFS
PAGE_SIZE=500

# Record massimi per layer, per le prove (0 = tutti)
MAX_RECORDS=0

# Richieste HTTP: tentativi, timeout (s), pausa tra le pagine (s)
HTTP_RETRIES=5
HTTP_TIMEOUT=180
PAUSE_SECONDS=0.5

LOG_LEVEL=INFO
